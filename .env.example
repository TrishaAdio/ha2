# Shared Telegram API credentials, used by both scripts.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_your_api_hash

# main.py session name.
TELEGRAM_SESSION=channel_copier

# main.py start mode: copy (interactive copier), commands (.change, .clone)
# or auto (the auto maker). Leave unset to be asked each run.
MAIN_MODE=

# Other accounts allowed to send the dot commands to this one, for example by
# private message: user ids or @usernames, comma separated. More can be added
# at runtime with .allow, which is saved in COMMAND_ADMINS_FILE.
COMMAND_ADMINS=
COMMAND_ADMINS_FILE=command_admins.json

# lol.py: how many chats to scan at once (default 8). Raise to sweep faster,
# lower if you hit flood limits.
SCAN_CONCURRENCY=

# iam.py: session for the new account, kept apart from the other scripts.
IAM_SESSION=iam_new_account
# How many profile photos to copy (default 10).
PHOTO_LIMIT=

# oho.py accounts. MAIN_SESSION reads the source and posts into every group.
# OWNER_SESSIONS lists the backup accounts that own the created groups.
# Leave OWNER_SESSIONS unset to be asked how many backup accounts to use.
MAIN_SESSION=oho_main
OWNER_SESSIONS=oho_owner1,oho_owner2,oho_owner3

# oho.py behaviour. Everything here is optional.
SHARE_WITH=siyorou
GROUP_TITLE=Archive
GROUP_USERNAME_PREFIX=archive
GROUP_ABOUT=
SOURCE_CHAT=
MESSAGE_DELAY=1.0
GROUP_DELAY=15.0
COPY_LIMIT=


# ---------------------------------------------------------------------------
# redirect.py: rotating channel cloner. setup.py writes all of these for you.
# ---------------------------------------------------------------------------
# Session for the rotating cloner, kept apart from the other scripts.
REDIRECT_SESSION=redirect

# Minutes a clone stays published before it is wiped and rebuilt. 10 is the
# floor and anything lower is raised to it. This only seeds the first run;
# afterwards .interval owns the value and it lives in redirect_state.json.
REDIRECT_INTERVAL=30

# How many clone channels each registered source produces per cycle, so how
# many links land in the assigned chat. Also first-run only; .clones owns it.
REDIRECT_CLONES=1

# Appended to every index title. Quote it: the leading space is meaningful,
# and an unquoted value loses it. Set to "" for no suffix at all.
INDEX_SUFFIX=" | Demo"

# Start rotating the moment redirect.py connects, without waiting for .start.
REDIRECT_AUTOSTART=false

# Where the slots, the interval and the live clones are stored. Delete this
# file to forget every registered channel.
REDIRECT_STATE=redirect_state.json


# How many times each invite link is repeated in the link post, one per line
# inside the blockquote. First-run only; .links owns it afterwards.
REDIRECT_LINK_REPEAT=5

# Only media posts whose caption mentions this word get a line in the index.
# Every post is cloned either way; this only decides what the index lists.
# Set to an empty value to list every post. First-run only; .filter owns it.
REDIRECT_FILTER=Dm

# One divider sticker per this many posts, through the runs the source leaves
# undivided. 0 turns dividers off. First-run only; .separator owns it after.
REDIRECT_SEPARATOR=2

# ---------------------------------------------------------------------------
# main.py mode 3: the auto maker (automaker.py)
# ---------------------------------------------------------------------------
# Where the worker accounts, their sessions and the settings are stored. This
# file holds full access to every worker account: keep it private, never
# commit it, and delete it to forget every worker.
AUTOMAKER_STATE=automaker_state.json

# Seconds a .login step waits for you to send the phone number, code or
# password before it gives up (default 300).
AUTOMAKER_ASK_TIMEOUT=300

# A worker asked to wait longer than this many seconds is set aside and the
# next worker is tried instead (default 300). Shorter waits are waited out.
AUTOMAKER_MAX_WAIT=300

# Seconds between two copies inside one .gen run (default 8).
AUTOMAKER_GEN_DELAY=8
